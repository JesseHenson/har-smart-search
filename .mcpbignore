# Build and dev cruft — never ship these inside the bundle.
__pycache__/
*.pyc
.pytest_cache/
.venv/
.superpowers/
.git/
*.db

# Repository material the runtime does not need.
tests/
docs/
scripts/
*.md
!BUNDLE.md
meeting_saved_closed_caption.txt
uv.lock

# Vendoring artifacts. The editable .pth holds an absolute path to this
# checkout: on the developer's own machine it makes an installed bundle
# import har_search from the working tree, so a broken bundle can still
# demo cleanly. lib/bin holds console scripts nothing here invokes.
lib/*.pth
lib/*/*.pth
lib/bin/
lib/*/bin/

# Design scratch, not product.
prototype/
